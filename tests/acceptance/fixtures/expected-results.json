        "counts": {
          "changed": 1,
          "unchanged": 4,
          "added": 0,
          "removed": 0,
          "conflict": 0,
          "invalid": 0
        },
        "parse_assertions": [
          "BOM removed only from start of first header",
          "5 data records, not 6 physical-line records",
          "Trailing empty Notes values retained",
          "Embedded CRLF and doubled-quote content preserved"
        ]
      }
    },
