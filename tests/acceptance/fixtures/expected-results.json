  "comparison_cases": [
    {
      "id": "rfc4180-and-bom",
      "before": "01-rfc-before.csv",
      "after": "01-rfc-after.csv",
      "options": {
        "trim_skus": false,
        "sku_matching": "case-sensitive exact text after optional trim",
        "before_sku_column": "SKU",
        "after_sku_column": "SKU",
        "before_value_column": "Price",
        "after_value_column": "Price",
        "before_decimal": "dot",
        "after_decimal": "dot"
      },
      "expected": {
        "rows": [
          {
            "sku": "COMMA,SKU",
            "status": "changed",
            "before_numeric": "10",
            "after_numeric": "11",
            "delta": "1"
          },
          {
            "sku": "QUOTE\"SKU",
            "status": "unchanged",
            "before_numeric": "2",
            "after_numeric": "2"
          },
          {
            "sku": "MULTILINE",
            "status": "unchanged",
            "before_numeric": "3.5",
            "after_numeric": "3.5"
          },
          {
            "sku": "café-01",
            "status": "unchanged",
            "before_numeric": "4",
            "after_numeric": "4"
          },
          {
