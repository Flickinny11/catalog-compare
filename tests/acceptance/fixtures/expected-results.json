{
  "format_version": 1,
  "purpose": "Synthetic independent acceptance fixtures, not app implementation or production supplier data",
  "created_date": "2026-10-06",
  "scope": "Exact SKU reconciliation of one explicitly selected numeric column per input",
  "conventions": {
    "records": "1-based logical CSV record numbers, header is record1; embedded newlines do not increment logical records",
    "status_counts": "Distinct nonblank comparison keys, not source-row counts. Missing-SKU rows counted separately. Conflicted keys never count as changed/unchanged/added/removed.",
    "numeric_expectations": "Decimal strings express exact expected numbers; JSON binary floating point is intentionally avoided.",
    "added_removed_direction": "Added = present only in after; removed = present only in before.",
    "proposed_contracts": [
      "Strict ungrouped decimal grammar described in case07",
      "Whitespace-only SKU is invalid even with trim off",
      "Malformed records reject the file instead of silently partial-comparing",
      "Formula safety for reports only, preserving exact matching keys"
    ],
    "contract_status": "Confirmed for the current release on 2026-10-06."
  },
